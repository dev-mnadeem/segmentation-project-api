# ---- runtime ----
NODE_ENV=development
PORT=7151

# ---- persistence ----
# mongo  : talk to MongoDB (MONGODB_URI required)
# memory : run entirely in-process, no database, data lost on restart
PERSISTENCE=mongo
MONGODB_URI=mongodb://localhost:27017/pearlai

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- auth ----
# AUTH_REQUIRED gates the write endpoints. Accepts true/false, 1/0, yes/no,
# on/off — anything else is rejected at startup rather than silently coerced.
AUTH_REQUIRED=false
# Required whenever AUTH_REQUIRED is on, or whenever /api/auth is used.
# Minimum 16 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# ---- label suggestion (POST /api/annotations/suggest-label) ----
# heuristic : deterministic nearest-neighbour over the project's own shapes.
#             No network, no key. This is the default.
# anthropic : ask Claude to rank the project's labels, falling back to the
#             heuristic on any error. Requires ANTHROPIC_API_KEY.
LABEL_SUGGESTER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- http ----
# "*" allows any origin. Otherwise a comma-separated allowlist.
CORS_ORIGIN=*
